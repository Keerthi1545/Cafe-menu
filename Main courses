print("\n" + "=" * 50)
print("         MAIN COURSE MENU")
print("=" * 50)

for category, items in main_course_menu.items():
    print(f"\n{category}")
    print("-" * 50)

    for item, price in items.items():
        print(f"{item:<35} ₹{price}")

print("\n" + "=" * 50)

# Ordering Process
total_bill = 0

while True:
    item_name = input("\nEnter main course item name: ")

    found = False

    for category in main_course_menu:
        if item_name in main_course_menu[category]:
            price = main_course_menu[category][item_name]
            total_bill += price
            print(f"{item_name} added to your order. ₹{price}")
            found = True
            break

    if not found:
        print("Item not found in Main Course Menu.")

    choice = input("Add another item? (yes/no): ").lower()

    if choice != "yes":
        break

print("\n" + "=" * 50)
print(f"Total Main Course Bill: ₹{total_bill}")
print("Thank you for dining with us!")
print("=" * 50)
